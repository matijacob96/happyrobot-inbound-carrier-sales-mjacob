# ===== API (apps/api) =====

# Service
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Auth — used by HappyRobot Webhook nodes and (transparently) by the dashboard
# BFF. The browser never sees this value: in production the dashboard's nginx
# injects it from a Cloud Run secret; locally Vite/nginx read it from this file.
# Generate a strong random key for production:  openssl rand -hex 32
API_KEY=dev-local-api-key-change-me

# Firestore — leave FIREBASE_PROJECT_ID set even when using the emulator
FIREBASE_PROJECT_ID=happyrobot-fde-poc
# Uncomment to point at the local Firestore emulator (overrides credentials)
# FIRESTORE_EMULATOR_HOST=localhost:8085

# FMCSA QCMobile API
# Get your own webKey at https://mobile.fmcsa.dot.gov/QCDevsite/login (Login.gov, free).
# NOTE: FMCSA geo-blocks non-US IPs. Set FMCSA_MOCK=true for local dev outside the US.
FMCSA_API_KEY=your-fmcsa-webkey-here
FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
FMCSA_CACHE_TTL_HOURS=24
FMCSA_MOCK=false

# CORS allowlist — only consumed if you call the API directly from a browser.
# The dashboard goes through its same-origin BFF so CORS is irrelevant in the
# normal flow. Wildcard is fine for local dev; in Cloud Run, deploy.sh tightens
# this to the dashboard URL automatically.
CORS_ORIGINS=*

# ===== Dashboard (apps/dashboard) =====

# Optional: override which API the Vite dev server proxies to. Defaults to
# http://localhost:8080 (the docker-compose API). Only relevant for `pnpm dev`.
# VITE_DEV_API_UPSTREAM=http://localhost:8080
