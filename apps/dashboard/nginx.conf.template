server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # Public DNS resolvers — required because proxy_pass uses a runtime variable.
  resolver 8.8.8.8 1.1.1.1 ipv6=off valid=60s;

  # ---------------------------------------------------------------------------
  # BFF: same-origin proxy that forwards /api/* to the upstream API and injects
  # the x-api-key header server-side. The browser never holds the API key.
  #
  # ${UPSTREAM_API}   = full base URL of the API (e.g. https://hr-api-xxx.run.app)
  # ${API_KEY}        = API key, injected from Cloud Run secret / docker-compose env
  # Both are populated by envsubst at container start (NGINX_ENVSUBST_FILTER
  # in the Dockerfile keeps envsubst from clobbering nginx variables like $uri).
  # ---------------------------------------------------------------------------
  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;

    proxy_set_header Host              $proxy_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header x-api-key         "${API_KEY}";

    proxy_http_version 1.1;
    proxy_set_header Connection "";

    proxy_pass ${UPSTREAM_API};
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri /index.html;
  }
}
